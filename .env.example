# Backend Environment Variables
# For Local Dev: sqlite:///./policylens.db
# For Production: postgresql://user:password@host:5432/postgres (Supabase)
DATABASE_URL=sqlite:///./policylens.db
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://your-production-url.vercel.app

# AI Models & Processing (Local Analysis Mode)
USE_ML_MODEL=true
SENTIMENT_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment-multilingual
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HF_TOKEN=your_huggingface_api_token_here

# Similarity & Classification Thresholds (tunable prototype values)
SIMILARITY_THRESHOLD=0.75
DUPLICATE_THRESHOLD=0.95
ISSUE_SIMILARITY_THRESHOLD=0.45
ASPECT_SIMILARITY_THRESHOLD=0.40

# Frontend Environment Variables
VITE_API_URL=http://localhost:8000
VITE_API_TIMEOUT_MS=100000
VITE_UPLOAD_TIMEOUT_MS=300000

